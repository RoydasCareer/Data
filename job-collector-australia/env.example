# ═══════════════════════════════════════════════
# .env.example — 환경변수 예시 파일
# 이 파일을 복사해서 .env로 저장 후 값을 채우세요.
# .env 파일은 절대 Git에 커밋하지 마세요!
# ═══════════════════════════════════════════════

# ──────────────────────────────────────────
# 필수: PostgreSQL 연결 문자열
# ──────────────────────────────────────────

# Supabase (권장)
# 형식: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.xxxx.supabase.co:5432/postgres

# Neon
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Railway
# DATABASE_URL=postgresql://postgres:password@monorail.proxy.rlwy.net:PORT/railway

# 로컬 PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/visa_jobs

# ──────────────────────────────────────────
# 선택: Group D 전문 API 키 (나중에 추가 시)
# ──────────────────────────────────────────

# USAJobs (미국 정부 채용)
# USAJOBS_API_KEY=your-api-key
# USAJOBS_EMAIL=your@email.com

# The Muse
# THE_MUSE_API_KEY=your-api-key

# Reed.co.uk
# REED_API_KEY=your-api-key
